{
  "lint": { "plugins": ["./lint/plugin.ts"] },
  "compilerOptions": { "lib": ["deno.ns", "dom", "dom.iterable"], "checkJs": true, "noImplicitAny": true },
  "fmt": { "include": ["main.ts", "src/", "public/js/", "public/css/", "lint/", "tests/", "scripts/"] },
  "tasks": {
    "dev": "deno run --unstable-kv --allow-net --allow-read --allow-env --watch main.ts",
    "start": "deno run --unstable-kv --allow-net --allow-read --allow-env main.ts",
    "start:env": "deno run --env-file=.env --unstable-kv --allow-net --allow-read --allow-env main.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check --unstable-kv main.ts playwright.config.ts src/server/*.ts src/shared/*.js src/client/*.js public/js/*.js tests/lint/*.ts tests/shared/*.ts tests/e2e/*.ts tests/client/*.ts tests/server/*.ts",
    "test": "deno test --unstable-kv --allow-read --allow-net --allow-env tests/lint tests/shared",
    "e2e": "deno run -A npm:playwright@1.63.0 test",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task test",
    "hooks": "git config core.hooksPath .githooks"
  },
  "imports": { "@std/assert": "jsr:@std/assert@1.0.19", "@playwright/test": "npm:@playwright/test@1.63.0" },
  "deploy": {
    "org": "legoguy32109",
    "app": "open-dwarf",
    "runtime": { "type": "dynamic", "entrypoint": "./main.ts" },
    "exclude": ["tests", "docs", "exports", ".env", ".env.*", ".githooks", ".github"]
  }
}
