{
  "tasks": {
    "fmt": "deno fmt && cd game_library && cargo fmt && cd ../game_engine && cargo fmt --all",
    "check": "deno fmt --check && deno lint && deno check **/*.ts && deno check **/*.tsx && cd game_library && cargo check && cargo check --target wasm32-unknown-unknown && cd ../game_engine && cargo check && cargo check --target wasm32-unknown-unknown",
    "dev": "vite",
    "start": "deno serve -A _fresh/server.js",
    "build": "vite build",
    "preview": "deno serve -A _fresh/server.js",
    "local": "cargo run --manifest-path ./game_library/Cargo.toml",
    "web-release": "bash scripts/bash/web-release.sh",
    "web-dev": "bash scripts/bash/web-dev.sh",
    "abi:gen": "bash scripts/bash/engine-abi-gen.sh",
    "engine:build": "bash scripts/bash/engine-build.sh",
    "engine:dev": "bash scripts/bash/engine-dev.sh",
    "engine:check": "bash scripts/bash/engine-check.sh",
    "engine:test": "bash scripts/bash/engine-test.sh",
    "engine:test-scenario": "bash scripts/bash/engine-test-scenario.sh",
    "engine:test-scenario-browser": "bash scripts/bash/engine-test-scenario-browser.sh",
    "engine:bless-goldens": "bash scripts/bash/engine-bless-goldens.sh",
    "engine:bless-goldens-native": "bash scripts/bash/engine-bless-goldens-native.sh",
    "engine:bless-goldens-browser": "bash scripts/bash/engine-bless-goldens-browser.sh",
    "font:msdf": "deno run -A scripts/generate_vga_msdf.ts",
    "unit": "deno test tests/unit/",
    "test": "npx playwright test",
    "show-tests": "npx playwright show-report exports/playwright-report --host 0.0.0.0"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*", "**/static/**/*open_dwarf*"],
  "fmt": { "exclude": ["game_library/", "static/", "node_modules/"] },
  "imports": {
    "@playwright/test": "npm:@playwright/test@1.52.0",
    "fflate": "npm:fflate@^0.8.3",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite",
    "tailwindcss": "npm:tailwindcss@^4.3.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.0",
    "vite": "npm:vite@^7.3.0",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "$std/": "https://deno.land/std@0.216.0/"
  },
  "compilerOptions": { "jsx": "react-jsx", "jsxImportSource": "preact" },
  "nodeModulesDir": "auto"
}
