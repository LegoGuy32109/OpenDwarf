{
  "lint": { "plugins": ["./lint/plugin.ts"], "exclude": ["_fresh/"] },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable"],
    "checkJs": true,
    "noImplicitAny": true
  },
  "fmt": {
    "include": [
      "main.ts",
      "AGENTS.md",
      "CONTEXT.md",
      "README.md",
      "docs/",
      "src/",
      "public/js/",
      "public/css/",
      "lint/",
      "tests/",
      "scripts/"
    ]
  },
  "tasks": {
    "dev": "OD_LOCAL_BUILD=1 deno run --unstable-kv --allow-net --allow-read --allow-env --watch main.ts",
    "start": "deno run --unstable-kv --allow-net --allow-read --allow-env main.ts",
    "start:env": "deno run --env-file=.env --unstable-kv --allow-net --allow-read --allow-env main.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check --unstable-kv main.ts playwright.config.ts scripts/*.ts src/server/*.ts src/shared/*.js src/client/*.js public/js/*.js tests/lint/*.ts tests/shared/*.ts tests/e2e/*.ts tests/client/*.ts tests/server/*.ts",
    "test": "deno test --unstable-kv --allow-read --allow-net --allow-env tests/lint tests/shared tests/client tests/server",
    "e2e": "deno run -A npm:playwright@1.63.0 test",
    "stress": "deno run -A scripts/stress.ts",
    "evidence:publish": "deno run --allow-run --allow-read --allow-write scripts/publish-evidence.ts",
    "capture:sync": "deno run -A scripts/capture-visual-sync.ts",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task test",
    "deploy": "deno run --allow-run --allow-read --allow-write=deno.json --allow-net --allow-env scripts/deploy.ts",
    "db:migrate": "deno run --env-file=.env --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/migrate.ts",
    "db:migrate:prod": "deno run --env-file=.env.prod --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/migrate.ts",
    "hooks": "git config core.hooksPath .githooks"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@playwright/test": "npm:@playwright/test@1.63.0",
    "@tursodatabase/serverless/compat": "npm:@tursodatabase/serverless@1.4.0/compat",
    "qrcode-svg": "npm:qrcode-svg@1.1.0"
  },
  "deploy": {
    "org": "legoguy32109",
    "app": "opendwarf",
    "runtime": { "type": "dynamic", "entrypoint": "./main.ts" },
    "exclude": [
      "tests",
      "docs",
      "exports",
      ".env",
      ".env.*",
      ".githooks",
      ".github"
    ]
  }
}
